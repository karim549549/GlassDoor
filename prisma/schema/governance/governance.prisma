/// Governance and platform-integrity models.
///
/// Each of these is required by a feature the PRD already specifies but that
/// previously had no table behind it: connection alerts ("Ahmed and 2
/// connections registered"), the dispute categories, and the audit trail that
/// bulk contact export needs to be defensible under Egypt's PDPL.

enum NotificationKind {
  ARENA_STARTING
  ARENA_RESULTS_PUBLISHED
  CONNECTION_JOINED_ARENA
  JUDGE_ASSIGNED
  SUBMISSION_SCORED
  APPEAL_RESOLVED
  PROOF_PACKET_ISSUED
  COMPANY_INVITE
}

enum DisputeCategory {
  PLAGIARISM_STOLEN_CODE
  RULE_VIOLATION
  BROKEN_OR_FAKE_SUBMISSION
  ABUSIVE_HARASSMENT
  SPAM_OR_OFF_TOPIC
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  DISMISSED
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       NotificationKind
  title      String
  body       String           @db.Text
  /// Where clicking it goes. Stored rather than derived so an old notification
  /// keeps working after routing changes.
  linkUrl    String?
  /// Loose references - deliberately not FKs, so deleting an arena does not
  /// cascade away the historical record that a notification was sent.
  arenaId    String?          @db.Uuid
  actorId    String?          @db.Uuid

  readAt     DateTime?
  createdAt  DateTime         @default(now())

  /// The inbox query: this user's unread, newest first.
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Dispute {
  id           String          @id @default(uuid()) @db.Uuid
  category     DisputeCategory
  status       DisputeStatus   @default(OPEN)

  reporterId   String          @db.Uuid
  reporter     User            @relation("DisputesRaised", fields: [reporterId], references: [id], onDelete: Cascade)

  /// What is being disputed. Exactly one should be set; which one is implied by
  /// the category (plagiarism targets a submission, harassment a comment).
  arenaId      String?         @db.Uuid
  arena        Arena?          @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  submissionId String?         @db.Uuid
  submission   ArenaSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  commentId    String?         @db.Uuid

  detail       String          @db.Text
  /// Set when a moderator resolves it; the note is shown to the reporter.
  resolvedById String?         @db.Uuid
  resolutionNote String?       @db.Text
  resolvedAt   DateTime?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([submissionId])
  @@map("disputes")
}

/// Append-only record of actions that touch other people's personal data.
///
/// Written for recruiter contact export and any admin action on a user. Under
/// PDPL a bulk export of developer contact details needs to be attributable
/// after the fact; without this table "who exported what, when" is unanswerable.
/// Never updated, never deleted.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  /// Free-text verb, e.g. "recruiter.export_contacts", "admin.revoke_packet".
  action     String
  /// What was acted on: a table name plus an id, kept loose so this table never
  /// needs a migration when a new action type appears.
  targetType String
  targetId   String?
  /// Arbitrary structured detail (row counts, filters used, packet slug).
  metadata   Json?
  /// Leftmost x-forwarded-for at the time of the action.
  ipAddress  String?

  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
