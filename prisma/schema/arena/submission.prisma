model ArenaSubmission {
  id           String                    @id @default(uuid()) @db.Uuid
  arenaId      String                    @db.Uuid
  arena        Arena                     @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  entryId      String                    @unique @db.Uuid
  entry        ArenaEntry                @relation(fields: [entryId], references: [id], onDelete: Cascade)
  
  githubUrl    String
  figmaUrl     String?
  /// Optional demo video of the finished product.
  videoUrl     String?
  writeupText  String                    @db.Text

  /// Recorded oral defense: the entrant answering generated questions about
  /// their OWN diff. This is the highest-signal anti-AI check in the product -
  /// you cannot explain reasoning you never had - and it is distinct from
  /// `videoUrl`, which is a product demo and proves nothing about authorship.
  defenseVideoUrl String?
  defenseRecordedAt DateTime?
  /// The questions the entrant was asked, snapshotted so the proof packet can
  /// show what was actually answered rather than regenerating them later.
  defensePrompts  Json?
  
  finalScore   Float?
  feedbackText String?                   @db.Text
  submittedAt  DateTime                  @default(now())
  withdrawnAt  DateTime?

  revisions    ArenaSubmissionRevision[]
  commits      SubmissionCommit[]
  assignments  JudgeAssignment[]
  appeal       Appeal?
  proofPacket  ProofPacket?
  disputes     Dispute[]

  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([arenaId])
  @@map("arena_submissions")
}

model ArenaSubmissionRevision {
  id             String          @id @default(uuid()) @db.Uuid
  submissionId   String          @db.Uuid
  submission     ArenaSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  revisionNumber Int             @default(1)
  
  githubUrl      String
  figmaUrl       String?
  videoUrl       String?
  writeupText    String          @db.Text

  createdAt      DateTime        @default(now())

  @@index([submissionId])
  @@map("arena_submission_revisions")
}

model SubmissionCommit {
  id           String          @id @default(uuid()) @db.Uuid
  submissionId String          @db.Uuid
  submission   ArenaSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  sha          String
  message      String?
  author       String?
  committedAt  DateTime
  rawPayload   Json?

  createdAt    DateTime        @default(now())

  @@unique([submissionId, sha])
  @@index([submissionId])
  @@map("submission_commits")
}

model ArenaRequirement {
  id          String    @id @default(uuid()) @db.Uuid
  arenaId     String    @db.Uuid
  arena       Arena     @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  title       String
  description String    @db.Text
  releasedAt  DateTime  @default(now())
  weight      Float     @default(1.0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([arenaId])
  @@map("arena_requirements")
}
