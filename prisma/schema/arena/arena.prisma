enum ArenaAuthority {
  OFFICIAL
  COMPANY
  COMMUNITY
}

enum RatingDomain {
  FULL_STACK_WEB
  BACKEND_DISTRIBUTED
  FRONTEND_MOBILE
  AI_MACHINE_LEARNING
  DATA_ENGINEERING
  CYBERSECURITY_ETHICAL_HACKING
  SYSTEMS_DEV_OPS
  EMBEDDED_IOT
  BLOCKCHAIN_WEB3
}

enum DifficultyTier {
  NOVICE
  INTERMEDIATE
  ADVANCED
  GRANDMASTER
}

enum PrizeCurrency {
  EGP
  USD
  EUR
  SAR
  AED
}

enum LocationType {
  ONLINE
  IN_PERSON
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Arena {
  id                       String            @id @default(uuid()) @db.Uuid
  title                    String
  description              String            @db.Text
  creatorId                String            @db.Uuid
  creator                  User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  authority                ArenaAuthority    @default(COMMUNITY)
  difficulty               DifficultyTier    @default(INTERMEDIATE)

  /// Dormant. Not asked for at creation, not shown, not filterable.
  ///
  /// Classifying a playful build challenge by engineering discipline was the
  /// hiring taxonomy in disguise - ArenaDomain's values were the JOB_TYPES list
  /// with different names - and it pushed hosts toward discipline-shaped briefs,
  /// which are the boring ones. "The worst landing page" is not frontend; the
  /// interesting half is "worst".
  ///
  /// The column survives where `format` and `intent` did not, because unlike
  /// them it still has consumers: the Glicko batch in lib/rating groups arenas
  /// by it, and a proof packet snapshots it. Rating is reserved for OFFICIAL and
  /// COMPANY arenas (PRD 7.1a), so this is the ladder's bucket waiting for the
  /// arenas that will fill it. Every community arena carries the default and
  /// nothing reads it.
  domain                   RatingDomain      @default(FULL_STACK_WEB)

  // Status is a pure function of phase timestamps + now.
  // publishedAt is null for DRAFT; canceledAt records cancellation; resultsPublishedAt locks results.
  publishedAt              DateTime?
  canceledAt               DateTime?
  resultsPublishedAt       DateTime?
  
  // Location
  locationType             LocationType      @default(ONLINE)
  locationName             String?
  googleMapsUrl            String?

  // Access Control & Gates
  isPrivate                Boolean           @default(false)
  inviteCode               String?           @unique
  minRatingToEnter         Int?
  requireHiringConsent     Boolean           @default(false)

  // Judging Config
  minJudgesPerSubmission   Int               @default(2)
  divergenceThreshold      Float             @default(15.0)

  // Prize Pool
  hasPrizePool             Boolean           @default(false)
  totalPrizePool           Float?
  prizeCurrency            PrizeCurrency     @default(EGP)
  firstPlacePrize          Float?
  secondPlacePrize         Float?
  thirdPlacePrize          Float?
  prizeDisbursementTerms   String?           @db.Text
  
  // Timeline Windows
  registrationStart        DateTime
  registrationEnd          DateTime
  ideaPhaseStart           DateTime
  ideaPhaseEnd             DateTime
  implPhaseStart           DateTime
  implPhaseEnd             DateTime

  // Team Setup
  isTeam                   Boolean           @default(false)
  minTeamSize              Int               @default(1)
  maxTeamSize              Int               @default(1)
  maxParticipants          Int?              
  allowLeaderAccessControl Boolean?          @default(true)
  
  // Submission Toggles
  requireGithubUrl         Boolean           @default(true)
  requireFigmaUrl          Boolean           @default(false)
  requireVideoUrl          Boolean           @default(false)
  requireWriteup           Boolean           @default(true)
  rulesText                String            @default("") @db.Text
  
  // Company & Sponsorship
  companyId                String?           @db.Uuid
  company                  Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sponsors                 ArenaSponsor[]

  // Relations
  entries                  ArenaEntry[]
  invitations              ArenaInvitation[]
  teams                    ArenaTeam[]
  submissions              ArenaSubmission[]
  requirements             ArenaRequirement[]
  rubrics                  Rubric[]
  judges                   ArenaJudge[]
  comments                 ArenaComment[]
  disputes                 Dispute[]

  isDeleted                Boolean           @default(false)
  deletedAt                DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([publishedAt])
  @@index([isPrivate])
  @@index([creatorId])
  @@index([createdAt])
  @@index([registrationStart])
  @@index([implPhaseEnd])
  @@map("arenas")
}

model ArenaEntry {
  id          String           @id @default(uuid()) @db.Uuid
  arenaId     String           @db.Uuid
  arena       Arena            @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  userId      String?          @db.Uuid
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId      String?          @db.Uuid
  team        ArenaTeam?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submission  ArenaSubmission?

  joinedAt    DateTime         @default(now())
  withdrawnAt DateTime?

  @@unique([arenaId, userId])
  @@unique([arenaId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("arena_entries")
}

model ArenaInvitation {
  id         String           @id @default(uuid()) @db.Uuid
  arenaId    String           @db.Uuid
  arena      Arena            @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  senderId   String           @db.Uuid
  sender     User             @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String           @db.Uuid
  receiver   User             @relation("ReceivedInvitations", fields: [receiverId], references: [id], onDelete: Cascade)
  status     InvitationStatus @default(PENDING)
  
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  /// One invitation per person per arena. Without it a double-clicked
  /// button invites someone twice, and the service check that guards against
  /// it loses to two requests in the same second.
  @@unique([arenaId, receiverId])
  @@index([arenaId])
  @@index([receiverId])
  @@index([senderId])
  @@map("arena_invitations")
}

model ArenaTeam {
  id        String            @id @default(uuid()) @db.Uuid
  arenaId   String            @db.Uuid
  arena     Arena             @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  name      String              
  members   ArenaTeamMember[]
  entries   ArenaEntry[]
  
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([arenaId, name])
  @@index([arenaId])
  @@map("arena_teams")
}

model ArenaTeamMember {
  teamId    String    @db.Uuid
  team      ArenaTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLeader  Boolean   @default(false)

  @@index([userId])
  @@id([teamId, userId])
  @@map("arena_team_members")
}
